#!/usr/bin/env bash
# kseat — drive this Hyprland seat when the connector is in the way.
#
# Two things this exists for:
#   1. An out-of-band path. SSH does not care whether the connector ate the Super
#      key, so this always works even when the desktop is unreachable.
#   2. Measuring what a connector actually delivers, rather than guessing.
#
# Hyprland 0.56 changed `hyprctl dispatch` to take Lua, so the old
# `hyprctl dispatch submap reset` form now fails silently-ish. This wraps the
# current syntax so callers do not have to remember it.

set -uo pipefail

# hyprctl needs an instance signature, and a non-login SSH shell has none.
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"
  if [[ -d $runtime ]]; then
    # Newest instance wins if a stale socket dir was left behind.
    sig=$(ls -1t "$runtime" 2>/dev/null | head -1)
    [[ -n $sig ]] && export HYPRLAND_INSTANCE_SIGNATURE="$sig"
  fi
fi

if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  echo "kseat: no Hyprland instance found — is a session running?" >&2
  exit 1
fi

MODULE='require("remote-seat")'
PROBE_LOG="$HOME/.cache/remote-seat-keys.log"

# hyprctl eval swallows return values; repl prints them.
lua()  { hyprctl eval "$1" >/dev/null 2>&1; }
luav() { hyprctl repl "$1" 2>/dev/null | tail -1; }

usage() {
  cat <<'USAGE'
kseat — remote-seat control for Omarchy/Hyprland

  kseat status              Session, connectors and layer state
  kseat layer on|off        Enter/leave the Super-substitute layer
  kseat menu                Open the Omarchy menu (works with no keyboard)
  kseat run '<lua>'         Dispatch any Hyprland action, e.g.
                              kseat run 'hl.dsp.window.close()'
  kseat send <mods> <key>   Send a real chord to the focused window, e.g.
                              kseat send ctrl+shift t
                              kseat send '' F11     (no modifier)
  kseat unstick             Reset the layer and clear stuck modifier state
  kseat binds [filter]      Cheat sheet: Super binding -> leader equivalent
  kseat probe on|off        Record which keys actually reach Hyprland
  kseat probe tail          Watch that recording live
  kseat probe clear         Empty the recording
  kseat hold [ms]           Show or set the bar button's hold duration
  kseat pad                 Show the floating modifier pad's settings
  kseat pad <key> <value>   Change one, e.g. kseat pad x 640
  kseat pad <corner>        Place it: top-left|top-right|bottom-left|
                              bottom-right|center [margin]
USAGE
}

cmd_status() {
  local submap probe leader
  submap=$(hyprctl submap 2>/dev/null)
  probe=$(luav "return $MODULE.probe_active()")
  leader=$(hyprctl binds -j | jq -r '
    def mods($m): [
      (if ($m/4|floor)%2==1 then "CTRL" else empty end),
      (if ($m/8|floor)%2==1 then "ALT"  else empty end)
    ];
    [.[]|select(.submap=="" and .description=="Remote layer (Super substitute)")]
    | map(((mods(.modmask)+[.key|ascii_upcase])|join("+"))) | join("  or  ")')

  echo "session"
  printf "  hyprland     %s\n" "$(hyprctl version 2>/dev/null | head -1 | awk '{print $2}')"
  printf "  instance     %s\n" "${HYPRLAND_INSTANCE_SIGNATURE:0:16}..."
  printf "  monitors     %s\n" "$(hyprctl monitors -j | jq -r '[.[].name]|join(", ")')"

  echo "connectors"
  if pgrep -x wayvnc >/dev/null 2>&1; then
    printf "  wayvnc       running on %s\n" "$(ss -ltnp 2>/dev/null | awk '/wayvnc/{print $4}' | head -1)"
  else
    printf "  wayvnc       not running\n"
  fi
  printf "  vnc clients  %s\n" "$(ss -tn state established 2>/dev/null | awk '$3 ~ /:5900$/' | wc -l)"
  printf "  virt kbds    %s\n" "$(hyprctl devices -j | jq -r '[.keyboards[]|select(.name|startswith("hl-virtual"))|.name]|join(", ")')"

  echo "remote layer"
  printf "  leader       %s\n" "${leader:-NOT REGISTERED}"
  printf "  state        %s\n" "$([[ $submap == remote ]] && echo "ACTIVE" || echo "inactive (map: ${submap:-default})")"
  printf "  mirrors      %s Super bindings\n" "$(hyprctl binds -j | jq '[.[]|select(.submap=="remote" and (.description|startswith("SUPER")))]|length')"
  printf "  function row %s keys the connector cannot send\n" "$(hyprctl binds -j | jq '[.[]|select(.submap=="remote" and (.key|ascii_upcase|test("^F[0-9]+$")))]|length')"
  printf "  key probe    %s\n" "$([[ $probe == true ]] && echo "recording -> $PROBE_LOG" || echo "off")"

  echo "app mode"
  printf "  pad mode     %s\n" "$(pad_mode)"
  printf "  state        %s\n" \
    "$([[ $submap == remote_app* ]] && echo "ARMED ($(luav "return $MODULE.app_mod_string()")) map: $submap" || echo "idle")"
  printf "  sticky       %s\n" "$(luav "return tostring($MODULE.app_sticky)")"
  printf "  chord keys   %s per combination, %s combinations\n" \
    "$(luav "return tostring(#$MODULE.app_keys)")" \
    "$(hyprctl binds -j | jq '[.[]|select(.submap|startswith("remote_app"))]|group_by(.submap)|length')"
}

# The pad's own config, read straight from the file the QML reads.
pad_mode() {
  python3 -c 'import json,pathlib,sys
p = pathlib.Path.home() / ".config/omarchy/remote-seat.json"
if not p.exists(): print("pad not installed"); sys.exit()
print(json.loads(p.read_text()).get("mode", "wm"))' 2>/dev/null || echo "unknown"
}

cmd_binds() {
  local filter="${1:-}"
  hyprctl binds -j | jq -r --arg f "$filter" '
    def mods($m): [
      (if ($m/64|floor)%2==1 then "SUPER" else empty end),
      (if ($m/4 |floor)%2==1 then "CTRL"  else empty end),
      (if ($m/8 |floor)%2==1 then "ALT"   else empty end),
      (if ($m/1 |floor)%2==1 then "SHIFT" else empty end)
    ];
    [.[]|select(.submap=="" and .modmask>=64 and (.description|length>0))]
    | map({
        combo: ((mods(.modmask)|join("+")) + "+" + (.key|ascii_upcase)),
        leader: (((mods(.modmask)-["SUPER"])|join("+")) as $r
                 | if $r=="" then (.key|ascii_upcase) else $r+"+"+(.key|ascii_upcase) end),
        desc: .description
      })
    | map(select($f=="" or (.desc|ascii_downcase|contains($f|ascii_downcase))
                        or (.combo|ascii_downcase|contains($f|ascii_downcase))))
    | sort_by(.desc)
    | (["BINDING","LEADER THEN","ACTION"], ["-------","-----------","------"]),
      (.[]|[.combo, .leader, .desc])
    | @tsv' | column -t -s$'\t'
}

case "${1:-status}" in
  status) cmd_status ;;
  layer)
    case "${2:-}" in
      on)  lua "$MODULE.enter()"; echo "layer: $(hyprctl submap)" ;;
      off) lua "$MODULE.leave()"; echo "layer: $(hyprctl submap)" ;;
      *)   echo "usage: kseat layer on|off" >&2; exit 2 ;;
    esac ;;
  menu)  hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-menu")' >/dev/null && echo "menu opened" ;;
  run)
    [[ $# -ge 2 ]] || { echo "usage: kseat run '<lua dispatcher>'" >&2; exit 2; }
    hyprctl dispatch "$2" ;;
  send)
    # Out-of-band chord injection. Same path the pad uses, so this also answers
    # "is app mode wired up?" without needing a keyboard the connector respects.
    [[ $# -ge 3 ]] || { echo "usage: kseat send <mods> <key>   (mods may be '')" >&2; exit 2; }
    result=$(luav "local ok, what = $MODULE.app_dispatch([[$2]], [[$3]]) return tostring(ok) .. ' ' .. tostring(what)")
    case "$result" in
      true*)  echo "  sent ${result#true }" ;;
      false*) echo "  refused: ${result#false }" >&2; exit 1 ;;
      *)      echo "  UNKNOWN: no answer from the seat module" >&2; exit 1 ;;
    esac ;;
  unstick)
    lua "$MODULE.leave()"
    hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1
    echo "layer reset; map is now: $(hyprctl submap)" ;;
  binds) cmd_binds "${2:-}" ;;
  pad)
    python3 - "${2:-}" "${3:-}" "${4:-}" <<'PYEOF'
import json, pathlib, subprocess, sys

p = pathlib.Path.home() / ".config/omarchy/remote-seat.json"
if not p.exists():
    sys.exit("kseat: the modifier pad is not installed")

cfg = json.loads(p.read_text())
args = [a for a in sys.argv[1:] if a != ""]
CORNERS = ("top-left", "top-right", "bottom-left", "bottom-right", "center")


def pad_size():
    """Mirror the QML layout maths so placement can be computed here.

    The row is: grip, mode switch, one button per modifier, close. Miss the mode
    switch out and every computed placement lands 45px short, which is how this
    was wrong before: measured 358 wide against a computed 313.
    """
    n = len(cfg.get("keys", []))
    sp, bw, bh = cfg.get("spacing", 5), cfg.get("buttonWidth", 60), cfg.get("buttonHeight", 34)
    grip, shut, mode = 16, 20, 40
    gaps = sp * (n + 2)          # n modifiers + grip + mode + close = n+3 cells
    if cfg.get("orientation") == "vertical":
        return 2 * sp + bw + 2, 2 * sp + grip + bh + n * bh + shut + gaps + 2
    return 2 * sp + grip + mode + n * bw + shut + gaps + 2, 2 * sp + bh + 2


def usable():
    """The layer sits inside the monitor minus reserved space (the bar)."""
    try:
        mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"],
                                         capture_output=True, text=True, timeout=5).stdout)
        m = next((x for x in mons if x.get("focused")), mons[0])
        r = m.get("reserved", [0, 0, 0, 0])
        return m["width"] - r[2] - r[3], m["height"] - r[0] - r[1]
    except Exception:
        return 1920, 1080


if not args:
    width = max(len(k) for k in cfg)
    for k, v in cfg.items():
        print(f"  {k.ljust(width)}  {json.dumps(v)}")
    pw, ph = pad_size()
    print(f"\n  computed size  {pw}x{ph}")
    sys.exit()

key = args[0]
value = args[1] if len(args) > 1 else ""

# Placement helpers: compute x/y rather than making the user do the arithmetic.
if key in CORNERS or key == "corner":
    corner = key if key in CORNERS else value
    if corner not in CORNERS:
        sys.exit(f"kseat: corner must be one of {', '.join(CORNERS)}")
    margin = int(args[2]) if len(args) > 2 and args[2] else (int(value) if key in CORNERS and value else 24)
    uw, uh = usable()
    pw, ph = pad_size()
    cfg["x"] = margin if "left" in corner else (uw - pw) // 2 if corner == "center" else uw - pw - margin
    cfg["y"] = margin if "top" in corner else (uh - ph) // 2 if corner == "center" else uh - ph - margin
    p.write_text(json.dumps(cfg, indent=2) + "\n")
    print(f"  {corner}: x={cfg['x']} y={cfg['y']}   (pad reloads on save)")
    sys.exit()

if key not in cfg:
    sys.exit(f"kseat: unknown setting '{key}'. Known: {', '.join(cfg)}, or a corner: {', '.join(CORNERS)}")
if not value:
    sys.exit(f"kseat: '{key}' needs a value")
if key == "orientation" and value not in ("horizontal", "vertical"):
    sys.exit("kseat: orientation must be horizontal or vertical")
if key == "mode" and value not in ("wm", "app"):
    sys.exit("kseat: mode must be wm (drive Hyprland bindings) "
             "or app (send real chords to the focused window)")

current = cfg[key]
try:
    if isinstance(current, bool):
        cfg[key] = value.lower() in ("1", "true", "yes", "on")
    elif isinstance(current, int):
        cfg[key] = int(value)
    elif isinstance(current, float):
        cfg[key] = float(value)
    elif isinstance(current, list):
        cfg[key] = [v.strip().upper() for v in value.split(",") if v.strip()]
    else:
        cfg[key] = value
except ValueError:
    sys.exit(f"kseat: '{value}' is not valid for {key} (expected {type(current).__name__})")

p.write_text(json.dumps(cfg, indent=2) + "\n")
print(f"  {key}: {json.dumps(current)} -> {json.dumps(cfg[key])}   (pad reloads on save)")
PYEOF
    ;;
  hold)
    # The bar button's tunable lives in shell.json, which hot-reloads on save.
    python3 - "${2:-}" <<'PYEOF'
import json, pathlib, sys
p = pathlib.Path.home() / ".config/omarchy/shell.json"
cfg = json.loads(p.read_text())
layout = cfg["bar"]["layout"]
entry = next((w for sec in ("left", "center", "right")
              for w in layout.get(sec, []) if w.get("id") == "io.github.example-user.remote-seat"), None)
if entry is None:
    sys.exit("kseat: the Super button is not on the bar")

arg = sys.argv[1] if len(sys.argv) > 1 else ""
if not arg:
    print(f"hold: {entry.get('holdMs', 4000)} ms")
    sys.exit()

try:
    ms = int(arg)
except ValueError:
    sys.exit(f"kseat: '{arg}' is not a number of milliseconds")
if ms < 250:
    sys.exit("kseat: hold must be at least 250 ms")

entry["holdMs"] = ms
p.write_text(json.dumps(cfg, indent=2) + "\n")
print(f"hold: {ms} ms (bar reloads on save)")
PYEOF
    ;;
  probe)
    case "${2:-}" in
      on)    echo "recording -> $(luav "return $MODULE.probe_on()")" ;;
      off)   lua "$MODULE.probe_off()"; echo "probe off" ;;
      tail)  echo "watching $PROBE_LOG (^C to stop)"; touch "$PROBE_LOG"; tail -f "$PROBE_LOG" ;;
      clear) : > "$PROBE_LOG"; echo "cleared" ;;
      *)     echo "usage: kseat probe on|off|tail|clear" >&2; exit 2 ;;
    esac ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
